# Supported drivers: mysql (default), pgsql, sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=test_db
DB_USERNAME=root
DB_PASSWORD=
# For sqlite, set DB_CONNECTION=sqlite and DB_DATABASE to a file path
# (e.g. storage/database.sqlite) or ":memory:" for an in-memory database.
# DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD are ignored for sqlite.

# ALLOWED_ORIGIN=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef, http://localhost:3000
ALLOWED_ORIGIN=*
# Only set to true if the API relies on cookies/HTTP auth for cross-origin requests.
CORS_ALLOW_CREDENTIALS=false

# Generate with: php -r "echo bin2hex(random_bytes(32));"
API_SECRET_KEY=

# Enables demo/debug-only routes (e.g. /db-test). Keep false in production.
APP_DEBUG=false

# Set when the app is served under a subpath instead of the domain root, e.g. an Apache
# Alias mapping https://host/rag/ to this app's public/ folder. Leave empty when mounted
# at "/". No trailing slash.
# BASE_PATH=/rag

# Optional plugins (see README > Plugins) add their own env vars here, e.g.
# wisp-jwt requires JWT_SECRET / JWT_TTL — see that plugin's .env.example.
